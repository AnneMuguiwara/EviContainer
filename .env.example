# Copia este archivo como .env y llena los valores. El .env NO se sube a git.

# --- API ECOSORT ---
API_BASE_URL=https://renova-3q4h.onrender.com/api
# Token del contenedor (panel de Ecosort o GET /containers/{id}/token)
CONTAINER_TOKEN=

# --- HARDWARE (Raspberry Pi) ---
# En Windows serían puertos COM, por ejemplo COM3.
ARDUINO_SENSORES_PORT=/dev/ttyUSB0
ARDUINO_MOTORES_PORT=/dev/ttyUSB1
QR_SCANNER_PORT=/dev/ttyACM0
BAUD_RATE=9600

# --- MODO SIMULACIÓN (laptop sin el hardware de la Pi) ---
# true: webcam o fotos de prueba en lugar de Picamera2, y el QR y el Arduino de
# sensores se simulan desde la terminal si no están conectados.
# OJO: los escaneos se registran en la API real con el CONTAINER_TOKEN de arriba.
SIMULATION_MODE=false
# auto | picamera | webcam | sample
CAMERA_MODE=auto
WEBCAM_INDEX=0
# Segundos sin teclas para cerrar sola la sesión en simulación (0 = solo con t).
SIM_SESSION_TIMEOUT=60

# --- PUENTE CON EVI (RenovaAvatar corriendo en la misma máquina) ---
EVI_NOTIFY_ENABLED=true
EVI_URL=http://127.0.0.1:3000/api
# Solo si en RenovaAvatar definiste CONTAINER_BRIDGE_KEY
EVI_BRIDGE_KEY=
# Serial del contenedor en Ecosort (ej. SN-0001), para que Evi identifique al usuario aquí
CONTAINER_SERIAL_NUMBER=
